<?xml version="1.0" encoding="utf-8"?>
<!-- SC-033 (Android 11 o menor): sin copias de seguridad automáticas. -->
<full-backup-content>
    <exclude domain="root"/>
    <exclude domain="file"/>
    <exclude domain="database"/>
    <exclude domain="sharedpref"/>
    <exclude domain="external"/>
</full-backup-content>
