<?xml version="1.0" encoding="utf-8"?>
<!--
  SC-033 (Android 12+): nada se copia a la nube ni a otro dispositivo. El almacén
  seguro (refresh token, id de instalación) y las cajas de Hive quedan fuera.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
